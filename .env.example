# NEXT_PUBLIC_API_URL: Base URL for VPD Technologies backend API services.
# Defaults to https://vpd-technologies-pvt-ltd-backend.vercel.app/api if omitted.
NEXT_PUBLIC_API_URL="https://vpd-technologies-pvt-ltd-backend.vercel.app/api"

# --- Server-side only. Never expose any of these with a NEXT_PUBLIC_ prefix ---
# They are consumed by app/api/contact, app/api/consultation and
# app/api/careers/apply.

# BREVO_API_KEY: secret transactional-email key. Generate at
# https://brevo.com (SMTP & API) and store it in the hosting environment's
# secret manager. If unset, submissions are still stored but no email is sent.
BREVO_API_KEY=
# BREVO_SENDER_EMAIL: must already be a verified sender in the Brevo account.
# Brevo rejects every send with a 4xx while it is unverified. An applicant's own
# address is never used as a sender.
BREVO_SENDER_EMAIL=info@vpdtechnologiespvtltd.com

# CONTACT_RECEIVER_EMAIL: inbox that receives the admin notifications for the
# contact form, the consultation form and the careers job-application form.
CONTACT_RECEIVER_EMAIL=info@vpdtechnologiespvtltd.com

# SITE_URL: the origin printed and linked in the footer of every transactional
# email. Server-side only; no NEXT_PUBLIC_ prefix is needed because only route
# handlers build the HTML. Trailing slashes are trimmed.
SITE_URL=https://www.vpdtechnologiespvtltd.com

# EMAIL_LOGO_URL: absolute, unauthenticated HTTPS URL for the logo shown in the
# header of every transactional email. Mail clients fetch it directly, so it must
# be a public asset — never a localhost, relative or authenticated URL. Verify it
# with `node scripts/check-email-logo-url.mjs <url>` before deploying. Unset falls
# back to /logo.png on the current Vercel deployment, which is byte-identical to
# this repository's public/logo.png. After the next deploy point it at the lighter
# 400x200 copy the same domain serves (https://www.vpdtechnologiespvtltd.com/email-logo.png)
# once the domain stops parking. The same artwork is also attached inline as
# cid:vpd-logo for Outlook, which often blocks remote images.
EMAIL_LOGO_URL=https://public-nu-sage-36.vercel.app/logo.png
